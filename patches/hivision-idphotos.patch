+# [二开] 原文件在模块级 import gradio（只被文件末尾的 __main__ 演示界面用到）；
+# 库调用路径不需要 gradio，已移除该 import 以精简依赖。
 
 
 class LutWhite:
@@ -46,7 +48,19 @@ class MakeWhiter:
 
 
 base_dir = os.path.dirname(os.path.abspath(__file__))
-default_lut = cv2.imread(os.path.join(base_dir, "lut/lut_origin.png"))
+
+
+def _imread_unicode(path):
+    """[二开] cv2.imread 在 Windows 上遇到非 ASCII 路径（比如把程序放在中文文件夹里）
+    会静默返回 None，而本文件在 import 阶段就要读 LUT，于是整个程序启动即崩。
+    改用 np.fromfile + cv2.imdecode，路径带中文也能读。"""
+    data = np.fromfile(path, dtype=np.uint8)
+    if data.size == 0:
+        return None
+    return cv2.imdecode(data, cv2.IMREAD_COLOR)
+
+
+default_lut = _imread_unicode(os.path.join(base_dir, "lut/lut_origin.png"))
 make_whiter = MakeWhiter(default_lut)
 
 
